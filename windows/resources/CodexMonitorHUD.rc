#include "resource.h"

#ifndef CODEX_MONITOR_WINDOWS_VERSION
#define CODEX_MONITOR_WINDOWS_VERSION "0.3.2"
#endif
#ifndef CODEX_MONITOR_WINDOWS_VERSION_MAJOR
#define CODEX_MONITOR_WINDOWS_VERSION_MAJOR 0
#endif
#ifndef CODEX_MONITOR_WINDOWS_VERSION_MINOR
#define CODEX_MONITOR_WINDOWS_VERSION_MINOR 3
#endif
#ifndef CODEX_MONITOR_WINDOWS_VERSION_PATCH
#define CODEX_MONITOR_WINDOWS_VERSION_PATCH 2
#endif

IDI_CODEX_MONITOR_HUD ICON "CodexMonitorHUD.ico"

1 VERSIONINFO
 FILEVERSION CODEX_MONITOR_WINDOWS_VERSION_MAJOR,CODEX_MONITOR_WINDOWS_VERSION_MINOR,CODEX_MONITOR_WINDOWS_VERSION_PATCH,0
 PRODUCTVERSION CODEX_MONITOR_WINDOWS_VERSION_MAJOR,CODEX_MONITOR_WINDOWS_VERSION_MINOR,CODEX_MONITOR_WINDOWS_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Codex Monitor HUD"
            VALUE "FileVersion", CODEX_MONITOR_WINDOWS_VERSION
            VALUE "InternalName", "CodexMonitorHUD"
            VALUE "OriginalFilename", "CodexMonitorHUD.exe"
            VALUE "ProductName", "Codex Monitor HUD"
            VALUE "ProductVersion", CODEX_MONITOR_WINDOWS_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
