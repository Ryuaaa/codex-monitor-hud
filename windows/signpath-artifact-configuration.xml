<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file
        path="build/Release/CodexMonitorHUD.exe"
        product-name="Codex Monitor HUD"
        product-version="${version}"
        file-version="${version}"
        original-filename="CodexMonitorHUD.exe">
      <authenticode-sign />
    </pe-file>
    <msi-file path="installer/CodexMonitorHUD-windows-x64-${version}.msi">
      <pe-file
          path="CodexMonitorHUD.exe"
          product-name="Codex Monitor HUD"
          product-version="${version}"
          file-version="${version}"
          original-filename="CodexMonitorHUD.exe">
        <authenticode-sign />
      </pe-file>
      <authenticode-sign />
    </msi-file>
  </zip-file>
</artifact-configuration>
